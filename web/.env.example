# Development only. No production credentials belong in this file.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://hvr:replace-me@localhost:5432/hvr_development
# Optional compose.local.yaml only: generate a random password and use the same value in DATABASE_URL.
# LOCAL_DATABASE_PASSWORD=replace-with-random-local-password
AIRTABLE_TOKEN=replace-with-test-base-pat
# CLI diagnostics only: a separate PAT restricted to this Base, schema.bases:read only.
# Do not add this token to Vercel runtime variables.
AIRTABLE_SCHEMA_TOKEN=replace-with-schema-read-only-pat
AIRTABLE_BASE_ID=appREPLACEWITH_TEST
AIRTABLE_USERS_TABLE=tblREPLACE_USERS
AIRTABLE_TASKS_TABLE=tblREPLACE_TASKS
AIRTABLE_UPDATES_TABLE=tblREPLACE_UPDATES
AIRTABLE_FOLLOWUPS_TABLE=tblREPLACE_FOLLOWUPS
AIRTABLE_NOTIFICATIONS_TABLE=tblREPLACE_NOTIFICATIONS
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
AUTH_SECRET=replace-with-at-least-32-random-characters
TASK_WRITES_ENABLED=false
JOBS_ENABLED=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_LINE_NOTIFICATIONS=false
# Separate AI OA. Never reuse the notification OA credentials here.
AI_LINE_ENABLED=false
FORMS_ENABLED=false
AI_FORMS_ENABLED=false
# AI_LINE_OA_ID=@672vhuss
# AI_LINE_BOT_USER_ID=U followed by 32 hexadecimal characters
# AI_LINE_CHANNEL_SECRET=configure-in-private-environment
# AI_LINE_CHANNEL_ACCESS_TOKEN=configure-in-private-environment
# Set only for a disposable database dedicated to integration tests.
# TEST_DATABASE_URL=postgresql://hvr:replace-me@localhost:5432/hvr_test
